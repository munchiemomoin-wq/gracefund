generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?
  avatarUrl     String?
  role          String    @default("visitor") // visitor, donor, fundraiser, organization, admin
  status        String    @default("active") // active, pending_verification, restricted, suspended, banned
  verificationLevel String @default("none") // none, basic, identity, beneficiary, organization
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaigns     Campaign[]
  donations     Donation[]
  organization  Organization?
  withdrawalRequests WithdrawalRequest[]
  reports       Report[]
  auditLogs     AuditLog[]
  favorites     Favorite[]
  verifications Verification[]
  notifications Notification[]
  riskEvents    RiskEvent[]
  reviewedCampaigns    Campaign[]    @relation("CampaignReviewer")
  reviewedWithdrawals  WithdrawalRequest[] @relation("WithdrawalReviewer")
  reviewedReports      Report[]      @relation("ReportReviewer")
  reviewedVerifications Verification[] @relation("VerificationReviewer")
  resolvedRiskEvents   RiskEvent[]   @relation("RiskEventResolver")
  reviewedCampaignEdits CampaignEdit[] @relation("CampaignEditReviewer")
  uploadedDocuments    PrivateDocument[] @relation("DocumentUploader")
  sentInfoRequests     InfoRequest[]  @relation("InfoRequester")
}

model Campaign {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  shortDescription String?
  story           String?
  categoryId      String?
  organizerId     String?
  beneficiaryName String?
  beneficiaryRelationship String?
  beneficiaryContact String?
  countryId       String?
  stateId         String?
  cityId          String?
  goalAmount      Float
  raisedAmount    Float     @default(0)
  currency        String    @default("INR")
  status          String    @default("draft") // draft, submitted, under_review, approved, published, paused, rejected, completed, closed, under_investigation
  verificationLevel String @default("none")
  isFeatured      Boolean   @default(false)
  isUrgent        Boolean   @default(false)
  campaignType    String    @default("individual") // individual, family, community, organization, charity
  campaignFeatures String?   // JSON: { donor_messages, anonymous_donations, campaign_updates, beneficiary_verification, fund_usage }
  coverImage      String?
  videoUrl        String?
  endDate         DateTime?
  donorCount      Int       @default(0)
  viewCount       Int       @default(0)
  riskLevel       String    @default("low") // low, medium, high — INTERNAL ONLY, never exposed publicly
  investigationSettings String? // JSON: { donations_paused, withdrawals_blocked, visible }
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  reviewNotes     String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category? @relation(fields: [categoryId], references: [id])
  organizer       User?     @relation(fields: [organizerId], references: [id])
  reviewer        User?     @relation("CampaignReviewer", fields: [reviewerId], references: [id])
  donations       Donation[]
  updates         CampaignUpdate[]
  withdrawalRequests WithdrawalRequest[]
  reports         Report[]
  favorites       Favorite[]
  fundUsageItems  FundUsageItem[]
  campaignEdits   CampaignEdit[]
  infoRequests    InfoRequest[]
  riskEvents     RiskEvent[]
}

model Donation {
  id                  String    @id @default(cuid())
  campaignId          String
  donorId             String?
  donorName           String?
  donorEmail          String?
  amount              Float
  currency            String    @default("INR")
  platformFee         Float     @default(0)
  paymentStatus       String    @default("pending") // pending, completed, failed, refunded
  paymentProvider     String?
  transactionReference String?
  donorMessage        String?
  isAnonymous         Boolean   @default(false)
  showNamePublicly    Boolean   @default(true)
  createdAt           DateTime  @default(now())

  campaign            Campaign  @relation(fields: [campaignId], references: [id])
  donor               User?     @relation(fields: [donorId], references: [id])
}

model CampaignUpdate {
  id        String   @id @default(cuid())
  campaignId String
  title     String
  content   String?
  imageUrl  String?
  status    String   @default("published") // published, hidden, under_review
  createdAt DateTime @default(now())

  campaign  Campaign @relation(fields: [campaignId], references: [id])
}

model Organization {
  id                  String    @id @default(cuid())
  ownerId             String    @unique
  name                String
  type                String    // nonprofit, charity, ngo, community_org, social_enterprise, educational_org, healthcare_org, animal_welfare_org, other
  description         String?
  logoUrl             String?
  coverImageUrl       String?
  website             String?
  country             String?
  city                String?
  registrationInfo    String?
  verificationStatus  String    @default("pending") // pending, verified, rejected
  socialLinks         String?   // JSON string
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner               User      @relation(fields: [ownerId], references: [id])
}

model WithdrawalRequest {
  id            String    @id @default(cuid())
  campaignId    String
  requesterId   String
  amount        Float
  status        String    @default("requested") // requested, under_review, documents_required, approved, processing, paid, rejected, suspended
  bankDetails   String?   // JSON string - sensitive, never expose publicly
  rejectionReason String?
  reviewerId    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  paymentReference String?
  paidAt        DateTime?
  requestedAt   DateTime  @default(now())
  processedAt   DateTime?

  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  requester     User      @relation(fields: [requesterId], references: [id])
  reviewer      User?     @relation("WithdrawalReviewer", fields: [reviewerId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  campaignId  String
  reporterId  String
  reason      String
  description String?
  status      String   @default("new") // new, under_review, resolved, dismissed, escalated
  riskLevel   String   @default("medium") // low, medium, high — internal
  adminNotes  String?
  reviewerId  String?
  reviewedAt  DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id])
  reporter    User     @relation(fields: [reporterId], references: [id])
  reviewer    User?     @relation("ReportReviewer", fields: [reviewerId], references: [id])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  campaigns   Campaign[]
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  action      String
  entityType  String
  entityId    String?
  previousValue String? // JSON string
  newValue    String?   // JSON string
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  admin       User?    @relation(fields: [adminId], references: [id])
}

model Favorite {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String?
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model PlatformSettings {
  id                  String   @id @default(cuid())
  key                 String   @unique
  value               String?
  updatedAt           DateTime @updatedAt
}

model Country {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  currency    String?
  currencySymbol String?
  active      Boolean  @default(true)

  states      State[]
}

model State {
  id          String   @id @default(cuid())
  name        String
  countryId   String
  code        String?

  country     Country  @relation(fields: [countryId], references: [id])
  cities      City[]
}

model City {
  id          String   @id @default(cuid())
  name        String
  stateId     String

  state       State    @relation(fields: [stateId], references: [id])
}

// ===== PHASE 4: TRUST, VERIFICATION, ANTI-FRAUD & COMPLIANCE =====

model Verification {
  id                String    @id @default(cuid())
  userId            String
  level             String    // basic, identity, beneficiary, organization
  status            String    @default("not_started") // not_started, pending, documents_submitted, under_review, verified, rejected, expired, suspended
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  reviewNotes       String?
  rejectionReason   String?
  expiryDate        DateTime?
  documents         String?   // JSON array of document references (private)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id])
  reviewer          User?     @relation("VerificationReviewer", fields: [reviewerId], references: [id])
}

model RiskEvent {
  id          String   @id @default(cuid())
  userId      String?
  campaignId  String?
  eventType   String    // duplicate_phone, duplicate_identity, multiple_campaigns, suspicious_edit, unusual_activity, multiple_reports, verification_failure, goal_change, beneficiary_change
  severity    String   @default("medium") // low, medium, high
  description String
  metadata    String?   // JSON string
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  resolver    User?    @relation("RiskEventResolver", fields: [resolvedBy], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String    // campaign_submitted, campaign_approved, campaign_rejected, info_requested, verification_approved, verification_rejected, withdrawal_status_changed, campaign_under_review, new_report, new_campaign_submitted, high_risk_detected, new_verification_submitted, withdrawal_requested
  title       String
  message     String
  entityType  String?   // campaign, withdrawal, verification, report
  entityId    String?
  isRead      Boolean   @default(false)
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
}

model CampaignEdit {
  id          String   @id @default(cuid())
  campaignId  String
  field       String    // title, story, goalAmount, beneficiaryName, beneficiaryRelationship, bankDetails
  oldValue    String?   // JSON or plain text
  newValue    String?   // JSON or plain text
  status      String    @default("pending") // pending, approved, rejected
  reviewerId  String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime @default(now())

  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  reviewer    User?     @relation("CampaignEditReviewer", fields: [reviewerId], references: [id])
}

model FundUsageItem {
  id          String   @id @default(cuid())
  campaignId  String
  category    String    // e.g. Hospital Expenses, Medicines, Recovery Support
  amount      Float
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime @default(now())

  campaign    Campaign  @relation(fields: [campaignId], references: [id])
}

model PrivateDocument {
  id          String   @id @default(cuid())
  entityType  String    // verification, campaign, withdrawal, organization, beneficiary
  entityId    String
  documentType String  // identity_proof, address_proof, organization_registration, medical_document, expense_proof, bank_document, beneficiary_proof, other
  fileName    String
  fileSize    Int?
  mimeType    String?
  storagePath String    // private storage path — never exposed via public URL
  uploadedById String?
  accessLevel String   @default("admin_only") // admin_only, reviewer_only
  status      String    @default("pending") // pending, approved, rejected
  reviewNotes String?
  createdAt   DateTime @default(now())

  uploadedBy  User?     @relation("DocumentUploader", fields: [uploadedById], references: [id])
}

model InfoRequest {
  id            String   @id @default(cuid())
  campaignId    String
  requesterId   String    // admin who requested
  message       String
  requiredDocuments String? // JSON array of required document types
  dueDate       DateTime?
 status        String    @default("pending") // pending, responded, resolved, cancelled
  responseMessage String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())

  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  requester     User      @relation("InfoRequester", fields: [requesterId], references: [id])
}
