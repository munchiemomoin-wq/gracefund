# ===== SUPABASE (Required - fill in keys from your Supabase dashboard) =====
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://qhmqmkfdoazngxubpzrc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ===== DATABASE =====
# Dashboard → Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL for Prisma (port 6543)
DATABASE_URL=postgresql://postgres.qhmqmkfdoazngxubpzrc:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ===== PAYMENT =====
PAYMENT_MODE=test

# ===== INTERNATIONAL DONATIONS =====
INTERNATIONAL_DONATIONS_ENABLED=false

# ===== PLATFORM FEES =====
PLATFORM_FEE_PERCENT=5
FIXED_TRANSACTION_FEE=0

# ===== VERIFICATION =====
AUTO_APPROVE_BASIC_VERIFIED=false
CAMPAIGN_EDIT_REQUIRES_REVIEW=true
WITHDRAWAL_REQUIRES_VERIFICATION=true

# ===== RATE LIMITING =====
REPORT_RATE_LIMIT_MINUTES=30

# ===== DOCUMENT STORAGE =====
SIGNED_URL_EXPIRY_SECONDS=300

# ===== SITE =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
